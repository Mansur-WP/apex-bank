# Copy to .env or export before running locally (optional — defaults work for dev).

SESSION_SECRET=change-me-in-production
DEBUG=True
LOCAL_DEV=1

# PostgreSQL (Replit / production). Leave unset to use SQLite (banking/db.sqlite3).
# DATABASE_URL=postgres://user:pass@localhost:5432/apex_bank

# Replit iframe hosting (set LOCAL_DEV=0 and enable partitioned cookies)
# LOCAL_DEV=0
# ENABLE_PARTITIONED_COOKIES=1
# REPLIT_DOMAINS=your-app.replit.app
